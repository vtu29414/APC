class Solution {
    public int leastInterval(char[] tasks, int n) {

        int[] freq = new int[26];

        // Count each task
        for (char task : tasks) {
            freq[task - 'A']++;
        }

        // Find maximum frequency
        int maxFreq = 0;

        for (int count : freq) {
            maxFreq = Math.max(maxFreq, count);
        }

        // Calculate idle slots
        int idleSlots = (maxFreq - 1) * n;

        // Fill idle slots with other tasks
        for (int count : freq) {
            idleSlots -= Math.min(count, maxFreq - 1);
        }

        // No idle time if all slots can be filled
        return tasks.length + Math.max(0, idleSlots);
    }
}
