class Solution {
    public int leastInterval(char[] tasks, int n) {

        // Count frequency of each task
        int[] freq = new int[26];

        for (char task : tasks) {
            freq[task - 'A']++;
        }

        // Find the maximum frequency
        int maxFreq = 0;

        for (int count : freq) {
            maxFreq = Math.max(maxFreq, count);
        }

        /*
         * Example:
         * A A A B B B, n = 2
         *
         * A _ _ A _ _ A
         *
         * maxFreq - 1 = 2 gaps
         * each gap has n = 2 slots
         *
         * (maxFreq - 1) * (n + 1) + 1
         * = 2 * 3 + 1
         * = 7
         *
         * But B tasks can fill some of the gaps:
         * A B _ A B _ A B = 8
         */

        int intervals = (maxFreq - 1) * (n + 1);

        // Count how many tasks have the maximum frequency
        int maxCount = 0;

        for (int count : freq) {
            if (count == maxFreq) {
                maxCount++;
            }
        }

        intervals += maxCount;

        // We never need more intervals than the number of tasks
        return Math.max(intervals, tasks.length);
    }
}
